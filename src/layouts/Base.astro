---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '@/styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '@/components/layout/Header.astro';
import Background from '@/components/layout/Background.astro';
import Footer from '@/components/layout/Footer.astro';
import Boot from '@/components/layout/Boot.astro';
import { languages, langs, defaultLang, t as useT, type Lang } from '@/i18n/ui';
import { themeNames } from '@/lib/themes';

interface Props {
  lang: Lang;
  /** Locale-less path, e.g. '' for home or 'projects/sudoku-2077'. Used for canonical + language switch. */
  path?: string;
  title?: string;
  description?: string;
  /** schema.org object, rendered as inert JSON-LD (no runtime JS). */
  jsonLd?: Record<string, unknown>;
  /** Share image, relative to /og/ without extension, e.g. 'en/gotdle'. Defaults to the locale's home card. */
  image?: string;
}

const { lang, path = '', title, description, jsonLd, image = `${lang}/home` } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} · Robert Villa` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const imageUrl = new URL(`/og/${image}.png`, Astro.site).href;
const urlFor = (l: Lang) => new URL(getRelativeLocaleUrl(l, path), Astro.site).href;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={urlFor(lang)} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLang)} />
    {path === '' && <link rel="expect" href="#projects" blocking="render" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c0a18" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:locale" content={languages[lang].og} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline define:vars={{ themeNames }}>
      // Runs before paint so the saved theme never flashes. An unknown saved value falls back to the system.
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = themeNames.includes(saved)
          ? saved
          : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      } catch {}
    </script>
    <script is:inline>
      // First-visit boot log (015): home only, once, never under reduced motion or blocked storage. Flag saved up front.
      try {
        if (/^\/(?:(?:es|ca)\/)?$/.test(location.pathname) && !localStorage.booted && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          localStorage.booted = 1;
          document.documentElement.dataset.boot = '';
        }
      } catch {}
    </script>
    <script is:inline>
      // View-transition morph targets (008). Runs before motion.ts, which must not hide the target.
      (() => {
        const slugOf = (u) => /\/projects\/([^/]+)\/?$/.exec(new URL(u).pathname)?.[1];
        let named; // one home card carries names at a time; duplicates would cancel the transition
        const name = (slug) => {
          for (const s of [named, slug]) {
            const li = document.getElementById('p-' + s);
            for (const [sel, n] of [['.card', 'card'], ['.card__title', 'title'], ['.card__shot', 'shot']])
              li?.querySelector(sel)?.style.setProperty('view-transition-name', s === slug ? `${n}-${s}` : '');
          }
          named = slug;
        };
        const act = window.navigation?.activation;
        const slug = slugOf(location.href) || (act?.from && slugOf(act.from.url));
        if (slug && act?.from && act.navigationType !== 'reload' && matchMedia('(prefers-reduced-motion: no-preference)').matches)
          document.documentElement.dataset.vt = slug;
        addEventListener('pageswap', (e) => {
          const to = e.activation?.entry.url;
          if (e.viewTransition && to && slugOf(to)) name(slugOf(to));
        });
        addEventListener('pagereveal', (e) => {
          const from = window.navigation?.activation?.from?.url; // read now: a bfcache restore has a new activation
          if (!e.viewTransition || slugOf(location.href) || !from || !slugOf(from)) return;
          name(slugOf(from));
          e.viewTransition.finished.then(() => name());
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Boot />
    <Background />
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '@/scripts/boot';
      import '@/scripts/theme';
      import '@/scripts/terminal';
      import '@/scripts/motion';
      import '@/scripts/sparkle';
      import '@/scripts/trail';
    </script>
  </body>
</html>
