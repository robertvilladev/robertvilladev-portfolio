---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Projects from '@/components/sections/Projects.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Contact from '@/components/sections/Contact.astro';
import { getProjects, slugOf } from '@/lib/projects';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { personLd } from '@/lib/jsonld';
import { langs, langParam, type Lang } from '@/i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang: langParam(lang) }, props: { lang } }));

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = await getProjects(lang);
---

<Base lang={lang} jsonLd={personLd(lang, Astro.site!, new URL(getRelativeLocaleUrl(lang), Astro.site).href)}>
  <Hero lang={lang} slugs={projects.map(slugOf)} />
  <About lang={lang} />
  <Projects lang={lang} projects={projects} />
  <Timeline lang={lang} />
  <Contact lang={lang} />
</Base>
