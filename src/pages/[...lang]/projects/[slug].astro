---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '@/layouts/Base.astro';
import Terminal from '@/components/ui/Terminal.astro';
import { projectLd } from '@/lib/jsonld';
import { repoData, slugOf, projectPaths, type Project } from '@/lib/projects';
import { ago } from '@/lib/github';
import { t as useT, type Lang } from '@/i18n/ui';

export const getStaticPaths = projectPaths;

interface Props { lang: Lang; entry: Project }
const { lang, entry } = Astro.props;
const t = useT(lang);
const slug = slugOf(entry);
const { title, summary, stack, pid, repo, demo, private: isPrivate } = entry.data;
const { Content } = await render(entry);
const gh = await repoData(entry);
// Language colors: existing tokens only, so both themes work. `other` is always the last, neutral one.
const swatch = (name: string, i: number) => (name === 'other' ? 'var(--ph)' : ['var(--accent)', 'var(--accent-2)', 'var(--hash)', 'var(--body)'][i]);
---

<Base lang={lang} path={`projects/${slug}`} title={title} description={summary} image={`${lang}/${slug}`} jsonLd={projectLd(lang, Astro.site!, new URL(getRelativeLocaleUrl(lang, `projects/${slug}`), Astro.site).href, entry, gh)}>
  <section class="detail pixgrid">
    <div class="container stack">
      <a class="back mono" href={`${getRelativeLocaleUrl(lang)}#p-${slug}`}>&lt; {t('project.back')}</a>
      <Terminal title={`~/side-projects/${slug} — PID ${pid}`} status={t('projects.running')} corners class="window" id={`p-${slug}`} style={`view-transition-name:card-${slug}`} data-zoom>
        <div class="window__grid">
          <div class="shot pixgrid scan mono" style={`view-transition-name:shot-${slug}`} aria-hidden="true">[{slug}]</div>
          <div class="info">
            <p class="prompt">~ $ cat README.md</p>
            <h1 class="title" style={`view-transition-name:title-${slug}`}>{title}</h1>
            <p class="lead">{summary}</p>
            <div class="prose"><Content /></div>
            <div>
              <p class="mono label">{t('project.stack')}</p>
              <ul class="tags">{stack.map((s) => <li class="tag">{s}</li>)}</ul>
            </div>
            {gh && gh.languages.length > 0 && (
              <div>
                <p class="mono label">{t('project.languages')}</p>
                <div class="langbar" aria-hidden="true">{gh.languages.map((l, i) => <span style={`flex-grow:${l.pct};background:${swatch(l.name, i)}`} />)}</div>
                <ul class="langs mono">{gh.languages.map((l, i) => <li><span class="sw" style={`background:${swatch(l.name, i)}`} aria-hidden="true" />{l.name} {l.pct}%</li>)}</ul>
              </div>
            )}
            {gh && gh.commits.length > 0 && (
              <div>
                <p class="prompt">~ $ git log --oneline -3</p>
                <ul class="log mono">
                  {gh.commits.slice(0, 3).map((c) => (
                    <li><a href={c.url} target="_blank" rel="noopener">{c.sha.slice(0, 7)}</a> {c.subject} <span class="muted">· <time datetime={c.date}>{ago(c.date, lang)}</time></span></li>
                  ))}
                </ul>
              </div>
            )}
            <div class="links">
              {demo && <a class="btn btn--primary" href={demo} target="_blank" rel="noopener">{t('project.demo')}</a>}
              {isPrivate ? <p class="tag private">{t('projects.private')}</p> : <a class:list={['btn', { 'btn--primary': !demo }]} href={repo} target="_blank" rel="noopener">{t('project.source')}</a>}
            </div>
          </div>
        </div>
      </Terminal>
    </div>
  </section>
</Base>

<style>
  .detail { padding-block: clamp(40px, 8vw, 80px); min-height: calc(100svh - 61px); }
  .stack { display: flex; flex-direction: column; gap: 24px; }
  .back { align-self: flex-start; min-height: 44px; display: inline-flex; align-items: center; font-size: 14px; }
  .detail :global(.window) { box-shadow: 0 30px 90px var(--glow); }
  .window__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .shot { min-height: 280px; display: grid; place-items: center; font-size: 12px; color: var(--ph); border-right: 1px solid var(--line); }
  .info { padding: clamp(20px, 4vw, 32px); display: flex; flex-direction: column; gap: 20px; }
  .title { font-size: clamp(36px, 5vw, 52px); line-height: 1; letter-spacing: -0.02em; font-weight: 700; }
  .label { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .private { color: var(--accent-2); }
  .langbar { display: flex; gap: 2px; height: 8px; margin-bottom: 10px; }
  .langs { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; padding: 0; list-style: none; font-size: 13px; color: var(--body); }
  .langs li { display: flex; align-items: center; gap: 6px; }
  .sw { width: 8px; height: 8px; }
  .log { margin: 8px 0 0; padding: 0; list-style: none; font-size: 13px; line-height: 1.7; color: var(--body); overflow-wrap: anywhere; }
  .log a { color: var(--hash); text-decoration: underline; text-underline-offset: 3px; }
  .muted { color: var(--muted); }
  .prose { color: var(--body); line-height: 1.7; }
  .prose :global(p + p), .prose :global(ul) { margin-top: 12px; }
  .prose :global(ul) { padding-left: 20px; }
  .prose :global(li + li) { margin-top: 8px; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; color: var(--accent); }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
